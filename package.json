{
  "name": "rick-and-morty-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "typecheck": "vue-tsc --build",
